<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Version>0.7.2</Version>
    <AssemblyName>MicEffects.Audio</AssemblyName>
    <Product>Mic Effects</Product>
    <NAudioVersion>2.2.1</NAudioVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApoBinary Condition="'$(ApoBinary)' == ''">$(MSBuildProjectDirectory)/obj/native/MicEffects.Apo.dll</ApoBinary>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="$(NAudioVersion)" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.Core" Version="$(NAudioVersion)" GeneratePathProperty="true" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="$(PkgNAudio_Wasapi)/lib/netstandard2.0/NAudio.Wasapi.dll" LogicalName="NAudio.Wasapi.dll" />
    <EmbeddedResource Include="$(PkgNAudio_Core)/lib/netstandard2.0/NAudio.Core.dll" LogicalName="NAudio.Core.dll" />
    <EmbeddedResource Include="$(ApoBinary)" LogicalName="MicEffects.Apo.dll" />
  </ItemGroup>
</Project>
